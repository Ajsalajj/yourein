{
  "name": "caption-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI video editor: transcription, animated captions, timeline, MP4 export.",
  "scripts": {
    "dev": "next dev -p 3100 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3100 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "tsx --test tests/*.test.ts",
    "sample": "bash scripts/make-sample.sh",
    "e2e": "tsx scripts/e2e.ts",
    "ai": "cd ai-service && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8100",
    "ai:setup": "cd ai-service && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "ai:test": "cd ai-service && .venv/bin/python -m pytest -q",
    "stills": "tsx scripts/dev/stills.ts",
    "sample:import": "tsx scripts/import-sample.ts",
    "test:all": "npm run -s typecheck && npm run -s lint && npm test && npm run -s ai:test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anek-malayalam": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@remotion/bundler": "^4.0.537",
    "@remotion/captions": "^4.0.537",
    "@remotion/layout-utils": "^4.0.537",
    "@remotion/media-utils": "^4.0.537",
    "@remotion/player": "^4.0.537",
    "@remotion/renderer": "^4.0.537",
    "@remotion/shapes": "^4.0.537",
    "@remotion/transitions": "^4.0.537",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}

# ── Caption Studio configuration (copy to .env.local) ────────────────────────
# Where projects, uploads and exports are stored.
DATA_DIR=./data
# Upload limits.
MAX_UPLOAD_MB=2048
MAX_VIDEO_DURATION_SEC=10800

# Python AI service (npm run ai). Must be able to read DATA_DIR/projects (see STORAGE_ROOT below).
AI_SERVICE_URL=http://127.0.0.1:8100
# Optional shared secret between the app and the AI service. Set the SAME value in both.
AI_SERVICE_TOKEN=

# Optional: require a token for every API call (use this if the app is reachable from a network).
# Then open the app once with  http://localhost:3100/?token=...  - or send it as the x-studio-token header.
STUDIO_ACCESS_TOKEN=

# URL the render worker uses to fetch media from this app.
INTERNAL_BASE_URL=http://127.0.0.1:3100

# Chrome Headless Shell used by Remotion. Leave empty to let Remotion download its own on first export.
# (Playwright's build works too, e.g. /opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell)
BROWSER_EXECUTABLE=
# swangle = software GL (works everywhere); angle/egl for GPU machines.
REMOTION_GL=swangle
# 0 = automatic
RENDER_CONCURRENCY=0

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── AI service (ai-service/) environment ─────────────────────────────────────
# STORAGE_ROOT=./data/projects
# WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 ...
# WHISPER_CACHE=./ai-service/models
# WHISPER_DEVICE=auto          # cpu | cuda
# WHISPER_COMPUTE=int8         # int8 | float16 | float32

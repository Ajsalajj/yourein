# Copy to .env.local for local work, or add these in Vercel → Project → Settings → Environment Variables.
# Nothing here is needed to try the site locally: `npm run dev` runs with an embedded database and simulated payments.

# --- Required in production ---------------------------------------------------

# Any PostgreSQL database (Neon, Supabase, Vercel Postgres, RDS). Tables are created on first start.
# Without it a deployed site keeps data in a temporary folder and loses it on every restart.
DATABASE_URL=

# A long random string, e.g. the output of: openssl rand -base64 48
AUTH_SECRET=

# The public address of the site, no trailing slash. Used in invitation links, QR codes and the sitemap.
NEXT_PUBLIC_SITE_URL=https://yourein.com

# --- Payments (Razorpay) ------------------------------------------------------

# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys first, then rzp_live_….
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Recommended. Dashboard → Webhooks → add https://<your-site>/api/pay/webhook
# for the events payment.captured and order.paid, with this secret.
RAZORPAY_WEBHOOK_SECRET=

# --- Sign in with Google (optional) -------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI: https://<your-site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password reset emails (optional, Resend) ---------------------------------

RESEND_API_KEY=
EMAIL_FROM=YoureIn <hello@yourein.com>

# --- Search and analytics (all optional) ---------------------------------------

# The public address, used for canonical URLs, sitemaps and invitation links. Production: https://www.yourein.in
# NEXT_PUBLIC_SITE_URL=https://www.yourein.in

# Search Console / Bing Webmaster verification tags (only if you verify by HTML tag instead of DNS).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Shown on the Contact page. Until one of these exists, /contact stays out of search results.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Loads Google Analytics 4 after the page is interactive. Leave empty to load no analytics script at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Development and testing only ---------------------------------------------

# Set to 1 to simulate payments on a production build that has no Razorpay keys (staging, demos).
# Never set this on the live site: anyone could publish without paying.
# YOUREIN_TEST_PAYMENTS=1

# Where the embedded database keeps its files when DATABASE_URL is empty. Defaults to ./.data/db
# YOUREIN_DATA_DIR=

# Points the Razorpay Orders API at a stand-in. Only used by scripts/dev/pay-live-path.mjs.
# RAZORPAY_API_URL=

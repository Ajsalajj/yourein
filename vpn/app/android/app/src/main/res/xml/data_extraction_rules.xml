<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred between devices. The WireGuard private
  key is encrypted with a Keystore key that can't leave this device, so a
  restored copy would be useless; sessions and tunnel settings are device-specific.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

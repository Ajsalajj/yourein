#!/usr/sbin/nft -f
# /etc/nftables.conf on an Orvane gateway: forward tunnel traffic to the
# internet with NAT, and nothing else. Adjust "eth0" to the public NIC.
#
# Also enable forwarding (e.g. /etc/sysctl.d/99-orvane.conf):
#   net.ipv4.ip_forward = 1
#   net.ipv6.conf.all.forwarding = 1

flush ruleset

table inet orvane {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    udp dport 51820 accept                      # WireGuard
    tcp dport 8443 accept                       # orvane-agent (HTTPS) + latency probe
    tcp dport 22 accept                         # SSH - restrict to your admin IPs in production
    iifname "wg0" udp dport 53 accept           # DNS resolver, tunnel side only
    iifname "wg0" tcp dport 53 accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    # Clients may reach the internet, but not each other or the gateway's LAN.
    iifname "wg0" oifname "eth0" accept
  }

  chain postrouting {
    type nat hook postrouting priority 100;
    oifname "eth0" ip saddr 10.64.0.0/16 masquerade
    oifname "eth0" ip6 saddr fd00:64::/112 masquerade
  }
}

# /etc/unbound/unbound.conf.d/orvane.conf
# Recursive resolver reachable only inside the tunnel, with logging off.
# Point the gateway's "DNS inside tunnel" setting at 10.64.0.1 (and fd00:64::1).
server:
    interface: 10.64.0.1
    interface: fd00:64::1
    access-control: 10.64.0.0/16 allow
    access-control: fd00:64::/112 allow
    access-control: 0.0.0.0/0 refuse
    access-control: ::/0 refuse
    # No query or reply logging.
    verbosity: 0
    log-queries: no
    log-replies: no
    log-servfail: no
    use-syslog: no
    logfile: ""
    # Privacy hardening.
    hide-identity: yes
    hide-version: yes
    qname-minimisation: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    aggressive-nsec: yes
    prefetch: yes
